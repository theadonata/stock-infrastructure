# Shared baseline — kept identical across all stock-* repos, see CLAUDE.md
.env
.env.local
.claude/settings.local.json

# Repo-specific — Terraform (see terraform/)
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/terraform.tfvars
!terraform/**/terraform.tfvars.example
terraform/**/crash.log
terraform/**/crash.*.log
# .terraform.lock.hcl is intentionally NOT ignored — commit it so
# `terraform init` resolves the same provider versions every time.

# Repo-specific — Terragrunt (see terraform/root.hcl). Ephemeral copy of the
# module tree Terragrunt runs Terraform from; never has anything worth
# committing (the real state lives at the paths ignored above, not here).
terraform/**/.terragrunt-cache/

# Sealed Secrets private key backup (runbook.md §1 step 3) — plaintext
# key material, must never be committed even accidentally via `git add -A`.
sealed-secrets-key-backup.yaml

# Repo-specific — Helm chart dependencies (see charts/monitoring/Chart.yaml).
# `helm dependency build` re-downloads these from Chart.lock's pinned
# versions/digests every time (CI does this — see .github/workflows/ci.yml),
# so the tarballs themselves aren't worth committing; Chart.lock is (same
# reasoning as .terraform.lock.hcl above — not ignored).
charts/**/charts/*.tgz
